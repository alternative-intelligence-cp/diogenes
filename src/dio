def config_key(config_dir):
    """The config dir's part of a cache or roster file name: 16 hex digits of its sha256."""
    return hashlib.sha256(config_dir.encode('utf-8', 'surrogateescape')).hexdigest()[:16]


# ---------------------------------------------------------------- clocks

def utc_now():
    return datetime.now(timezone.utc)


def iso_z(moment):
    """A stored time: ISO 8601 in UTC with a Z suffix, to the microsecond (PROJECT_RULES §5)."""
    return moment.astimezone(timezone.utc).strftime('%Y-%m-%dT%H:%M:%S.%fZ')


def parse_iso_z(text):
    if type(text) is not str or not ISO_Z.fullmatch(text):
        raise ValueError('not an ISO 8601 UTC time')
    return datetime.strptime(text, '%Y-%m-%dT%H:%M:%S.%fZ').replace(tzinfo=timezone.utc)


def boot_clock():
    """(btime, clock ticks per second) from /proc/stat, to show a procStart as a clock time."""
    try:
        with open('/proc/stat', 'rb') as f:
            for line in f:
                if line.startswith(b'btime '):
                    return int(line.split()[1]), os.sysconf('SC_CLK_TCK')
    except (OSError, ValueError, IndexError):
        pass
    return None


def started_text(proc_start, clock):
    """The STARTED column: boot time plus procStart's ticks, in UTC, to the second."""
    if proc_start is None or clock is None:
        return '-'
    btime, hertz = clock
    try:
        moment = datetime.fromtimestamp(btime + int(proc_start) / hertz, timezone.utc)
    except (OverflowError, OSError, ValueError):
        return '-'
    return moment.strftime('%Y-%m-%dT%H:%M:%SZ')


# ---------------------------------------------------------------- reading files

class Refused(Exception):
    """A name that matched but is not a regular file. Nothing behind it was read."""


class Mismatch(Exception):
    """A file that does not parse as the expected format; carries its own version if readable."""

    def __init__(self, version=None):
        super().__init__(version)
        self.version = version


def read_regular(name, dir_fd, limit=RECORD_LIMIT):
    """The bytes of `name` in the directory open as `dir_fd`, or None if it holds more than `limit`.

    The open uses O_NOFOLLOW, so the kernel refuses a symlink (ELOOP) and its target is
    never opened, and O_NONBLOCK, so a FIFO cannot block the reader. Anything fstat does
    not call a regular file is refused before a byte is read.
    """
    try:
        fd = os.open(name, READ_FLAGS, dir_fd=dir_fd)
    except OSError as e:
        if e.errno == errno.ELOOP:
            raise Refused('symlink') from None
        if e.errno == errno.ENXIO:  # a socket file cannot be opened at all
            raise Refused('not a regular file') from None
        raise
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise Refused('not a regular file')
        chunks, size = [], 0
        while True:
            chunk = os.read(fd, 65536)
            if not chunk:
                return b''.join(chunks)
            size += len(chunk)
            if size > limit:
                return None
            chunks.append(chunk)
    finally:
        os.close(fd)


def _no_duplicate_keys(pairs):
    record = {}
    for key, value in pairs:
        if key in record:
            raise ValueError('duplicate key')
        record[key] = value
    return record


def _no_constants(name):
    raise ValueError('not JSON: ' + name)


def strict_json(raw):
    """UTF-8 JSON with no duplicate keys and no NaN or Infinity; ValueError otherwise."""
    if raw is None:
        raise ValueError('too large')
    text = raw.decode('utf-8')  # UnicodeDecodeError is a ValueError
    try:
        return json.loads(text, object_pairs_hook=_no_duplicate_keys, parse_constant=_no_constants)
    except RecursionError:
        raise ValueError('nested too deeply') from None


def _text(value):
    """A string with no control characters or lone surrogates, so a printed field stays on its line."""
    return type(value) is str and not CONTROL.search(value)


def _number(value):
    """A finite number, not negative, that a float can hold. math.isfinite converts an int to a
    float, and an int too large for one, such as a 400-digit integer, raises OverflowError: it
    does not count."""
    if type(value) not in (int, float):
        return False
    try:
        return math.isfinite(value) and value >= 0
    except OverflowError:
        return False


def _digits(value):
    return type(value) is str and DIGITS.fullmatch(value) is not None


def _absolute(value):
    return _text(value) and value.startswith('/')


def _optional(record, key, check):
    return key not in record or check(record[key])


def parse_session(raw, stem):
    """The strict parse of one sessions file, MIN.md step 1.

    Required: pid, an int equal to the file's name, which has at most PID_DIGITS digits;
    procStart, decimal digits (the process start time in clock ticks after boot, field 22
    of /proc/<pid>/stat); messagingSocketPath, an absolute path. Optional, and checked when present:
    sessionId and cwd (strings), name (text or null), status (busy, shell, idle or
    waiting), startedAt and updatedAt (finite numbers, not negative, that a float can
    hold), version (text). Other keys are ignored. Raises Mismatch, carrying the file's own
    version when it could be read. The record returned holds what dio who shows, and the
    sessionId (None when absent), by which dio meters names a context file.
    """
    try:
        record = strict_json(raw)
    except ValueError:
        raise Mismatch() from None
    if type(record) is not dict:
        raise Mismatch()
    version = record.get('version') if _text(record.get('version')) else None
    pid = record.get('pid')
    sound = (
        len(stem) <= PID_DIGITS and type(pid) is int and pid > 0 and str(pid) == stem
        and _digits(record.get('procStart'))
        and _absolute(record.get('messagingSocketPath'))
        and _optional(record, 'sessionId', lambda v: type(v) is str)
        and _optional(record, 'cwd', lambda v: type(v) is str)
        and _optional(record, 'name', lambda v: v is None or _text(v))
        and _optional(record, 'status', lambda v: type(v) is str and v in STATUS_STATE)
        and _optional(record, 'startedAt', _number)
        and _optional(record, 'updatedAt', _number)
        and _optional(record, 'version', _text)
    )
    if not sound:
        raise Mismatch(version or None)
    return {'pid': pid, 'procStart': record['procStart'],
            'socket': record['messagingSocketPath'], 'name': record.get('name') or None,
            'status': record.get('status'), 'version': version or None,
            'sessionId': record.get('sessionId')}


def read_sessions_root(root):
    """List `root` with os.scandir and read every entry named like ^[0-9]+\\.json$.

    Every other entry is discarded here, unread, unstat'ed and unlogged. Returns
    [(stem, outcome)] in pid order, where the outcome is the parsed record, a Mismatch,
    a Refused, or an OSError. A file removed since the listing is skipped: its session
    has ended. Raises OSError if `root` itself cannot be opened.
    """
    dir_fd = os.open(root, DIR_FLAGS)
    try:
        names = [entry.name for entry in os.scandir(dir_fd) if SESSIONS_FILE.fullmatch(entry.name)]
        outcomes = []
        for name in sorted(names, key=lambda n: (len(n), n)):
            stem = name[:-len('.json')]
            try:
                raw = read_regular(name, dir_fd)
            except Refused as refused:
                outcomes.append((stem, refused))
                continue
            except FileNotFoundError:
                continue
            except OSError as e:
                outcomes.append((stem, e))
                continue
            try:
                outcomes.append((stem, parse_session(raw, stem)))
            except Mismatch as mismatch:
                outcomes.append((stem, mismatch))
        return outcomes
    finally:
        os.close(dir_fd)


# ---------------------------------------------------------------- the process check

def proc_start_of(pid):
    """Field 22 of /proc/<pid>/stat (start time, clock ticks after boot), or None if no such process."""
    try:
        fd = os.open('/proc/%d/stat' % pid, os.O_RDONLY | os.O_CLOEXEC)
    except (FileNotFoundError, ProcessLookupError):
        return None
    try:
        data = os.read(fd, 4096)
    except ProcessLookupError:
        return None
    finally:
        os.close(fd)
    close = data.rfind(b')')  # the command name, field 2, may itself hold ')' or spaces
    fields = data[close + 2:].split() if close >= 0 else []
    if len(fields) < 20:
        return None
    return fields[19].decode('ascii')


def process_check(pid, proc_start, socket_path):
    """DR-108: /proc/<pid> exists, its start time equals procStart, the socket file exists.

    Returns None when all three hold, else which one failed. The socket file must be a
    socket, not merely a name. An OSError other than "no such file" propagates: it means
    the check could not be made, which is not evidence of anything.
    """
    started = proc_start_of(pid)
    if started is None:
        return 'no process'
    if started != proc_start:
        return 'start time differs'
    try:
        mode = os.stat(socket_path).st_mode
    except (FileNotFoundError, NotADirectoryError):
        return 'no socket file'
    if not stat.S_ISSOCK(mode):
        return 'not a socket'
    return None


# ---------------------------------------------------------------- the zone's directories

def open_zone_dir(state_root, leaf):
    """Open <state root>/<leaf> as a directory fd, making the leaf (mode 0700) if it is missing.

    Neither the state root nor the leaf may be a symlink (O_NOFOLLOW), so a write never
    lands through a link into another tree. Raises OSError.
    """
    root_fd = os.open(state_root, DIR_FLAGS | os.O_NOFOLLOW)
    try:
        try:
            os.mkdir(leaf, 0o700, dir_fd=root_fd)
        except FileExistsError:
            pass
        return os.open(leaf, DIR_FLAGS | os.O_NOFOLLOW, dir_fd=root_fd)
    finally:
        os.close(root_fd)


def write_new(dir_fd, data):
    """Write `data` to a fresh temporary file (mode 0600) in `dir_fd` and return its name."""
    name = '.tmp-%d-%s' % (os.getpid(), os.urandom(6).hex())
    fd = os.open(name, WRITE_FLAGS, 0o600, dir_fd=dir_fd)
    try:
        os.write(fd, data)
    finally:
        os.close(fd)
    return name


def dumps(record):
    return (json.dumps(record, sort_keys=True, indent=1) + '\n').encode('utf-8')


# ---------------------------------------------------------------- the grace cache

class GraceCache:
    """dio who's grace for `gone`: one small file per entry whose process check failed.

    The file is cache/grace-<config key>-<pid>.json under the state root, so it is keyed
    by config dir and pid, and both accounts' runs share one file set. It holds the first
    failed check's time and the time `gone` begins, both absolute UTC, with the grace
    beside them. A new entry is published with link(), which never replaces a file, so
    when two runs race the first writer's time stands. A passing check removes the entry.
    """

    def __init__(self, state_root, now):
        self.now = now
        self.dir_fd = None
        self.problem = None
        try:
            self.dir_fd = open_zone_dir(state_root, 'cache')
        except OSError as e:
            self.problem = '%s: %s' % (os.path.join(state_root, 'cache'), e.strerror)

    def close(self):
        if self.dir_fd is not None:
            os.close(self.dir_fd)
            self.dir_fd = None

    @staticmethod
    def entry_name(config_dir, pid):
        return 'grace-%s-%d.json' % (config_key(config_dir), pid)

    def _load(self, name):
        """(found, entry): entry is None when the file is absent or not in this format."""
        try:
            raw = read_regular(name, self.dir_fd)
        except FileNotFoundError:
            return False, None
        except (Refused, OSError):
            return True, None
        try:
            entry = strict_json(raw)
            if type(entry) is not dict:
                return True, None
            entry['firstFailedAt'] = parse_iso_z(entry.get('firstFailedAt'))
            entry['goneAt'] = parse_iso_z(entry.get('goneAt'))
        except ValueError:
            return True, None
        return True, entry

    @staticmethod
    def _same(entry, config_dir, pid, proc_start):
        return (entry is not None and entry.get('configDir') == config_dir
                and entry.get('pid') == pid and entry.get('procStart') == proc_start)

    def _publish(self, name, record, replace):
        temporary = write_new(self.dir_fd, dumps(record))
        try:
            if replace:
                os.replace(temporary, name, src_dir_fd=self.dir_fd, dst_dir_fd=self.dir_fd)
                temporary = None
                return True
            try:
                os.link(temporary, name, src_dir_fd=self.dir_fd, dst_dir_fd=self.dir_fd)
            except FileExistsError:
                return False
            return True
        finally:
            if temporary is not None:
                os.unlink(temporary, dir_fd=self.dir_fd)

    def failed(self, config_dir, pid, proc_start, reason):
        """The state of an entry whose check failed: `unknown (checking)`, then `gone`.

        An existing entry for the same config dir, pid and procStart times the grace. Any
        other file under the name (an entry for an earlier process with that pid, or one
        not in this format) is replaced by a fresh entry, whose grace starts now.
        """
        if self.dir_fd is None:
            return CHECKING  # nothing can time the grace, so it never ends
        name = self.entry_name(config_dir, pid)
        now = self.now()
        found, entry = self._load(name)
        if self._same(entry, config_dir, pid, proc_start):
            return GONE if now >= entry['goneAt'] else CHECKING
        record = {'configDir': config_dir, 'pid': pid, 'procStart': proc_start,
                  'failedCheck': reason, 'firstFailedAt': iso_z(now),
                  'graceSeconds': GRACE_SECONDS,
                  'goneAt': iso_z(now + timedelta(seconds=GRACE_SECONDS))}
        try:
            if not self._publish(name, record, replace=found):
                found, entry = self._load(name)  # another run published first
                if self._same(entry, config_dir, pid, proc_start):
                    return GONE if now >= entry['goneAt'] else CHECKING
                self._publish(name, record, replace=True)
        except OSError as e:
            warn('the grace cache could not be written, so the grace was not started: %s'
                 % e.strerror)
        return CHECKING  # a fresh entry: its grace has just begun

    def passed(self, config_dir, pid):
        if self.dir_fd is None:
            return
        try:
            os.unlink(self.entry_name(config_dir, pid), dir_fd=self.dir_fd)
        except OSError:
            pass  # usually "no such file": the check had not failed before

    def prune(self, config_dir, keep_pids):
        """Remove this config dir's entries for pids with neither a sessions file nor a roster entry."""
        if self.dir_fd is None:
            return
        key = config_key(config_dir)
        try:
            stale = []
            for entry in os.scandir(self.dir_fd):
                match = GRACE_FILE.fullmatch(entry.name)
                if match and match.group(1) == key and int(match.group(2)) not in keep_pids:
                    stale.append(entry.name)
            for name in stale:
                try:
                    os.unlink(name, dir_fd=self.dir_fd)
                except FileNotFoundError:
                    pass
        except OSError as e:
            warn('the grace cache could not be pruned: %s' % e.strerror)


# ---------------------------------------------------------------- the roster (dio register)

def parse_roster_entry(raw, name):
    """dio register's own format; None if the entry is not in it."""
    match = ROSTER_FILE.fullmatch(name)
    try:
        entry = strict_json(raw)
    except ValueError:
        return None
    if type(entry) is not dict or set(entry) != {'configDir', 'messagingSocketPath', 'name', 'pid',
                                                 'procStart', 'registeredAt'}:
        return None
    try:
        parse_iso_z(entry['registeredAt'])
    except ValueError:
        return None
    pid = entry['pid']
    if not (_absolute(entry['configDir']) and match.group(1) == config_key(entry['configDir'])
            and type(pid) is int and pid > 0 and str(pid) == match.group(2)
            and _digits(entry['procStart']) and _absolute(entry['messagingSocketPath'])
            and _text(entry['name']) and entry['name']):
        return None
    return entry


def read_roster(state_root):
    """The roster's entries in dio register's format. A missing roster/ means none."""
    try:
        root_fd = os.open(state_root, DIR_FLAGS | os.O_NOFOLLOW)
        try:
            dir_fd = os.open('roster', DIR_FLAGS | os.O_NOFOLLOW, dir_fd=root_fd)
        finally:
            os.close(root_fd)
    except FileNotFoundError:
        return []
    except OSError as e:
        warn('cannot read the roster under %s: %s' % (state_root, e.strerror))
        return []
    try:
        entries = []
        names = sorted(e.name for e in os.scandir(dir_fd) if ROSTER_FILE.fullmatch(e.name))
        for name in names:
            try:
                entry = parse_roster_entry(read_regular(name, dir_fd), name)
            except (Refused, OSError):
                entry = None
            if entry is None:
                warn('ignored roster entry %s: not in dio register\'s format' % name)
            else:
                entries.append(entry)
        return entries
    finally:
        os.close(dir_fd)


# ---------------------------------------------------------------- one pass of dio who

class Row:
    __slots__ = ('account', 'config_dir', 'pid', 'name', 'proc_start', 'socket', 'version',
                 'state', 'source')

    def __init__(self, account, config_dir, pid, state, name=None, proc_start=None, socket=None,
                 version=None, source='sessions'):
        self.account, self.config_dir, self.pid, self.state = account, config_dir, pid, state
        self.name, self.proc_start, self.socket, self.version = name, proc_start, socket, version
        self.source = source

    @property
    def live(self):
        return self.state in LIVE

    @property
    def label(self):
        """Every line not from the sessions file says so."""
        return '  ' + FALLBACK_LABEL if self.source == 'register' else ''


def trailing_key(row):
    """Sort key: the name's trailing _N in numeric order; names without one first, then by name.

    N is compared as text: fewer digits after its leading zeros first, then digit by digit,
    which is numeric order at any length. int() would refuse an N of more than 4300 digits
    (Python's default limit), and a name ending in one is still text that dio register accepts.
    """
    match = TRAILING_N.fullmatch(row.name or '')
    if match:
        digits = match.group(2).lstrip('0')
        return (1, (len(digits), digits), row.name, row.account)
    return (0, (0, ''), row.name or '', row.account)


def checked_state(cache, config_dir, pid, proc_start, socket, status):
    try:
        failure = process_check(pid, proc_start, socket)
    except OSError as e:
        return 'unknown (no process check: %s)' % errno.errorcode.get(e.errno, e.errno)
    if failure is None:
        cache.passed(config_dir, pid)
        return STATUS_STATE.get(status, 'live')
    return cache.failed(config_dir, pid, proc_start, failure)


def survey(roots, state_root, now=utc_now):
    """One pass: every sessions file under every root, then the roster entries that no
    strictly parsed sessions file covers, labelled as the fallback. Returns rows in order."""
    cache = GraceCache(state_root, now)
    if cache.problem:
        warn('the grace cache cannot be written, so a failed check stays "%s": %s'
             % (CHECKING, cache.problem))
    try:
        rows, covered, seen, accounts, order = [], set(), {}, {}, {}
        for label, root in roots:
            config_dir = os.path.dirname(os.path.abspath(root))
            accounts.setdefault(config_dir, label)
            order.setdefault(label, len(order))
            try:
                outcomes = read_sessions_root(root)
            except OSError as e:
                warn('cannot read the %s sessions directory %s: %s' % (label, root, e.strerror))
                continue
            seen.setdefault(config_dir, set()).update(int(stem) for stem, _ in outcomes
                                                      if len(stem) <= PID_DIGITS)
            # The version record: the version of the first strictly parsed file, in pid order,
            # that carries one. A mismatched file with no readable version of its own shows it.
            record_version = next((o['version'] for _, o in outcomes
                                   if type(o) is dict and o['version']), None)
            for stem, outcome in outcomes:
                if type(outcome) is dict:
                    covered.add((config_dir, outcome['pid']))
                    state = checked_state(cache, config_dir, outcome['pid'], outcome['procStart'],
                                          outcome['socket'], outcome['status'])
                    rows.append(Row(label, config_dir, stem, state, outcome['name'],
                                    outcome['procStart'], outcome['socket'], outcome['version']))
                elif isinstance(outcome, Mismatch):
                    shown = outcome.version or record_version or 'version unknown'
                    rows.append(Row(label, config_dir, stem, 'unknown (sessions format: %s)' % shown,
                                    version=outcome.version))
                elif isinstance(outcome, Refused):
                    rows.append(Row(label, config_dir, stem, 'unknown (refused: %s)' % outcome))
                else:
                    rows.append(Row(label, config_dir, stem, 'unknown (unreadable: %s)'
                                    % errno.errorcode.get(outcome.errno, outcome.errno)))
        for entry in read_roster(state_root):
            config_dir, pid = entry['configDir'], entry['pid']
            if config_dir in seen:
                seen[config_dir].add(pid)
            if (config_dir, pid) in covered:
                continue
            label = accounts.get(config_dir) or os.path.basename(config_dir).lstrip('.') or '-'
            order.setdefault(label, len(order))
            state = checked_state(cache, config_dir, pid, entry['procStart'],
                                  entry['messagingSocketPath'], None)
            rows.append(Row(label, config_dir, str(pid), state, entry['name'], entry['procStart'],
                            entry['messagingSocketPath'], source='register'))
        for config_dir, pids in seen.items():
            cache.prune(config_dir, pids)
    finally:
        cache.close()
    rows.sort(key=lambda r: (order[r.account], trailing_key(r),
                             int(r.pid) if len(r.pid) <= PID_DIGITS else 0))
    return rows


# ---------------------------------------------------------------- output

HEADER = ('ACCOUNT', 'NAME', 'PID', 'STARTED', 'VERSION', 'SOCKET', 'STATE')


def render(rows, clock):
    """A table, two spaces between columns, STATE last; a roster row ends with its label."""
    table = [HEADER] + [(r.account, r.name or '-', r.pid, started_text(r.proc_start, clock),
                         r.version or '-', r.socket or '-', r.state + r.label) for r in rows]
    widths = [max(len(line[i]) for line in table) for i in range(len(HEADER) - 1)]
    return '\n'.join('  '.join([cell.ljust(width) for cell, width in zip(line, widths)]
                               + [line[-1]]).rstrip() for line in table)


# ---------------------------------------------------------------- the role line

class RolesError(Exception):
    pass


def read_roles(path):
    """{role: [holder, ...]} from the first fenced block of the role file (meta/ROLES.md's format:
    one `<role> = <holder>[, <holder>...]` per line; nothing outside the block is a role line)."""
    with open(path, encoding='utf-8') as f:
        lines = f.read().splitlines()
    fences = [i for i, line in enumerate(lines) if line.strip().startswith('```')]
    if len(fences) < 2:
        raise RolesError('%s: no fenced role block' % path)
    roles = {}
    for number in range(fences[0] + 1, fences[1]):
        line = lines[number].strip()
        if not line:
            continue
        match = ROLE_LINE.fullmatch(line)
        holders = [h.strip() for h in match.group(2).split(',')] if match else []
        if not match or not all(_text(h) and h for h in holders) or match.group(1) in roles:
            raise RolesError('%s:%d: not a role line: %s' % (path, number + 1, line))
        roles[match.group(1)] = holders
    return roles


def bare_prefix(name):
    """The name without its trailing _N, or None if it has none."""
    match = TRAILING_N.fullmatch(name or '')
    return match.group(1) if match else None


def resolve_address(rows, wanted, highest, role_file):
    """MIN.md step 1's --address. Returns (exit status, stdout lines, stderr lines)."""
    live = [r for r in rows if r.live and r.name]
    try:
        roles = read_roles(role_file)
    except FileNotFoundError:
        roles = {}
        notes = ['dio: no role file at %s; resolving names only' % role_file]
    except (OSError, UnicodeDecodeError, RolesError) as e:
        return 2, [], ['dio: cannot read the role file: %s' % e]
    else:
        notes = []
    if wanted in roles:
        holders = roles[wanted]
        found = [r for r in live if r.name in holders]
        if not found:
            return 1, [], notes + ['dio: %s = %s: no live holder' % (wanted, ', '.join(holders))]
        return pick(found, False, notes)
    exact = [r for r in live if r.name == wanted]
    if exact:
        return pick(exact, False, notes)
    prefixed = [r for r in live if bare_prefix(r.name) == wanted]
    if prefixed:
        return pick(prefixed, highest, notes)
    return 1, [], notes + ['dio: no live session for %s' % wanted]


def pick(found, highest, notes):
    found = sorted(found, key=trailing_key)
    if len(found) == 1:
        return 0, [found[0].socket + found[0].label], notes
    if highest:
        top = trailing_key(found[-1])[1]
        tied = [r for r in found if trailing_key(r)[1] == top]
        if len(tied) == 1:
            return 0, [tied[0].socket + tied[0].label], notes + [
                'dio: --highest chose %s of %d live' % (tied[0].name, len(found))]
    lines = ['%s  %s  %s%s' % (r.socket, r.name, r.account, r.label) for r in found]
    return 1, lines + ['ambiguous: %d live' % len(found)], notes


# ---------------------------------------------------------------- dio register

def register(name, state_root, config_dir, pid, environ, now):
    """Write this seat's roster entry. Returns (exit status, stdout lines, stderr lines)."""
    if not (_text(name) and name):
        return 2, [], ['dio register: the name must be text with no control characters']
    socket_path = environ.get('CLAUDE_CODE_MESSAGING_SOCKET', '')
    if not socket_path:
        return 1, [], ['dio register: CLAUDE_CODE_MESSAGING_SOCKET is not set; '
                       "run it from the seat's own Bash"]
    if not _absolute(socket_path):
        return 1, [], ['dio register: CLAUDE_CODE_MESSAGING_SOCKET is not an absolute path']
    if pid is None:
        match = SOCKET_PID.fullmatch(os.path.basename(socket_path))
        if not match:
            return 1, [], ['dio register: the socket file is not named <pid>.sock; pass --pid']
        pid = int(match.group(1))
    try:
        proc_start = proc_start_of(pid)
    except OSError:  # ENAMETOOLONG: a --pid of thousands of digits, a path /proc cannot name
        proc_start = None
    if proc_start is None:
        return 1, [], ['dio register: no process %d' % pid]
    try:
        is_socket = stat.S_ISSOCK(os.stat(socket_path).st_mode)
    except OSError:
        is_socket = False
    if not is_socket:
        return 1, [], ['dio register: no socket at %s' % socket_path]
    config_dir = os.path.abspath(os.path.expanduser(
        config_dir or environ.get('CLAUDE_CONFIG_DIR') or '~/.claude'))
    entry = {'configDir': config_dir, 'messagingSocketPath': socket_path, 'name': name,
             'pid': pid, 'procStart': proc_start, 'registeredAt': iso_z(now())}
    entry_name = '%s-%d.json' % (config_key(config_dir), pid)
    roster = os.path.join(state_root, 'roster')
    try:
        dir_fd = open_zone_dir(state_root, 'roster')
    except OSError as e:
        return 1, [], ['dio register: %s: %s' % (roster, e.strerror)]
    temporary = None
    try:
        temporary = write_new(dir_fd, dumps(entry))
        os.replace(temporary, entry_name, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
        temporary = None
    except OSError as e:
        return 1, [], ['dio register: %s: %s' % (roster, e.strerror)]
    finally:
        if temporary is not None:
            try:
                os.unlink(temporary, dir_fd=dir_fd)
            except OSError:
                pass
        os.close(dir_fd)
    return 0, ['registered %s  pid %d  %s  %s' % (name, pid, socket_path, FALLBACK_LABEL)], []


# ---------------------------------------------------------------- dio watch (MIN.md step 3)

WATCH_EVERY = 60  # --every's default: MIN.md step 3's `--every 60`
WATCH_CAP = 3000  # --max's default, 50 minutes: provisional until the gate's DX-13 legs
WATCH_LIMIT = 86400  # the most whole seconds --every or --max takes: one day
# A name not present at the start wakes the watch only if its mtime is later than the start
# less this margin. The kernel stamps mtimes from a coarse clock that trails time.time_ns(),
# by up to 1.849 ms in the runs on record (src/README.md), so a file made just after the start
# can carry an mtime just before it.
MTIME_MARGIN_NS = 2 * 10 ** 9
# What a printed path escapes, so its line stays one line: a backslash, C0 and C1 controls,
# DEL, the line and paragraph separators, and lone surrogates (a byte that is not UTF-8).
WATCH_ESCAPE = re.compile(r'[\\\x00-\x1f\x7f-\x9f\u2028\u2029\ud800-\udfff]')
WATCH_HELP = (
    "MIN.md step 3: the background until loop the seat runs, with its Bash tool's "
    "run_in_background. It lists DIR, then reads the clock: the start. Every --every seconds "
    "it stats each name that was not in DIR at the start, never opening one, and the first "
    "regular file whose mtime is later than the start less 2 s ends it: WAKE <path>, exit 0. "
    "A file present at the start never wakes it, whatever its mtime. After --max seconds with "
    "no such file it prints REARM <dir> and exits 1, so the seat re-arms. A refusal exits 2. "
    "The seat reads the clock before arming each watch, and after every exit re-arms first, "
    "then reads every regular file in DIR whose mtime is later than the previous reading "
    "less 2 s, which covers a file that lands between two watches (src/README.md).")


class SystemClock:
    """dio watch's clocks. The real clock gives the start, which mtimes are compared with; the
    monotonic clock times the cap, so a step of the real clock cannot stretch or cut it."""

    @staticmethod
    def real_ns():
        return time.time_ns()

    @staticmethod
    def monotonic_ns():
        return time.monotonic_ns()

    @staticmethod
    def sleep(seconds):
        time.sleep(seconds)


def printable(text):
    """`text` on one line: each character WATCH_ESCAPE matches becomes an escape, a backslash
    `\\\\`, a byte that is not UTF-8 `\\xNN` of that byte, any other `\\xNN` or `\\uNNNN`."""
    def escape(match):
        character = match.group()
        if character == '\\':
            return '\\\\'
        code = ord(character)
        if 0xdc80 <= code <= 0xdcff:  # how os.fsdecode holds a byte that is not UTF-8
            return '\\x%02x' % (code - 0xdc00)
        return '\\x%02x' % code if code <= 0xff else '\\u%04x' % code
    return WATCH_ESCAPE.sub(escape, text)


class WatchError(Exception):
    """The directory cannot be watched: refused at the start, or gone or changed since."""


def open_watched(path):
    """(fd, identity) of the directory at `path`. The open uses O_DIRECTORY and O_NOFOLLOW, so
    anything but a real directory is refused, a symlink even to a directory. Raises WatchError."""
    try:
        fd = os.open(path, DIR_FLAGS | os.O_NOFOLLOW)
    except FileNotFoundError:
        raise WatchError('no such directory: %s' % printable(path)) from None
    except NotADirectoryError:
        try:
            link = stat.S_ISLNK(os.lstat(path).st_mode)
        except OSError:
            link = False
        raise WatchError('%s: %s' % ('a symlink, not a directory' if link else 'not a directory',
                                      printable(path))) from None
    except OSError as e:
        raise WatchError('cannot read %s: %s' % (printable(path), e.strerror)) from None
    try:
        st = os.fstat(fd)
    except OSError:
        os.close(fd)
        raise
    return fd, (st.st_dev, st.st_ino)


def names_in(dir_fd):
    """Every name in the directory open as `dir_fd`. os.scandir reads the directory itself only."""
    with os.scandir(dir_fd) as entries:
        return [entry.name for entry in entries]


def start_watch(path):
    """(absolute path, identity, the names present at the start). Raises WatchError."""
    try:
        absolute = os.path.join(os.getcwd(), path) if path and not os.path.isabs(path) else path
        fd, identity = open_watched(absolute)
    except OSError as e:  # os.getcwd() or os.fstat
        raise WatchError('cannot read %s: %s' % (printable(path), e.strerror)) from None
    try:
        return absolute, identity, frozenset(names_in(fd))
    except OSError as e:
        raise WatchError('cannot read %s: %s' % (printable(absolute), e.strerror)) from None
    finally:
        os.close(fd)


def new_regular_files(absolute, identity, present, since_ns):
    """[(mtime_ns, name)] of the regular files in the directory whose names are not in
    `present` and whose mtime is later than `since_ns`. The directory is opened again and
    must be the same one (device and inode). Each new name is stat'ed relative to it without
    following a symlink (fstatat with AT_SYMLINK_NOFOLLOW) and never opened. Raises WatchError."""
    try:
        fd, now = open_watched(absolute)
    except OSError as e:  # os.fstat
        raise WatchError('cannot read %s: %s' % (printable(absolute), e.strerror)) from None
    try:
        if now != identity:
            raise WatchError('%s is another directory now' % printable(absolute))
        found = []
        for name in names_in(fd):
            if name in present:
                continue
            try:
                st = os.stat(name, dir_fd=fd, follow_symlinks=False)
            except FileNotFoundError:
                continue  # removed since the listing
            if stat.S_ISREG(st.st_mode) and st.st_mtime_ns > since_ns:
                found.append((st.st_mtime_ns, name))
        return found
    except OSError as e:
        raise WatchError('cannot read %s: %s' % (printable(absolute), e.strerror)) from None
    finally:
        os.close(fd)


def watch(path, every, cap, clock):
    """MIN.md step 3's wait. Returns (exit status, stdout lines, stderr lines).

    It lists the directory, then reads the real clock: the start. A name listed then never
    wakes it, whatever its mtime. It polls at once and then every `every` seconds: the first
    regular file, by mtime and then by name, among the new names whose mtime is later than
    the start less MTIME_MARGIN_NS ends it with `WAKE <path>`, exit 0. Once `cap` seconds have
    passed on the monotonic clock with none, it ends with `REARM <dir>`, exit 1. The last
    sleep is cut to the cap, and a poll comes after it, so a file that lands in the last
    interval still wakes it. A refusal, or the directory gone, replaced or unreadable during
    the watch, ends it with exit 2.
    """
    try:
        absolute, identity, present = start_watch(path)
    except WatchError as e:
        return 2, [], ['dio watch: %s' % e]
    since = clock.real_ns() - MTIME_MARGIN_NS
    deadline = clock.monotonic_ns() + cap * 10 ** 9
    while True:
        try:
            found = new_regular_files(absolute, identity, present, since)
        except WatchError as e:
            return 2, [], ['dio watch: during the watch, %s' % e]
        if found:
            return 0, ['WAKE ' + printable(os.path.join(absolute, min(found)[1]))], []
        left = deadline - clock.monotonic_ns()
        if left <= 0:
            return 1, ['REARM ' + printable(absolute)], []
        clock.sleep(min(every * 10 ** 9, left) / 10 ** 9)


# ---------------------------------------------------------------- dio meters (FINISH.md step 7)

METERS_FRESH = 600  # a usage or context file reads `measured` while its age is at most this (F4)
LEDGER_LIMIT = 1024 * 1024  # the most bytes read from one credits ledger
# A context file is <session id>.json, the id matching the Team writer's own ^[A-Za-z0-9_-]+$
# (FINISH.md step 7), so the writer's temporary .ctx.* files never match.
CONTEXT_FILE = re.compile(r'[A-Za-z0-9_-]+\.json', re.ASCII)
LEDGER_HEADER = ('started', 'ended', 'job', 'model', 'turns', 'cost', 'status', 'rc')
SEPARATOR_CELL = re.compile(r':?-+:?', re.ASCII)  # one cell of a Markdown table's separator line
TEAM_JOB = ' (team)'  # a job cell that ends with it bills the Team org's credits
METERS_HELP = (
    "FINISH.md step 7: a read-only printer of both accounts' usage files, context files and the "
    "credits ledgers, one tab-separated record per line, its first field naming it: usage (Max "
    "first), model_limits, context (by account, then session id) and credits (each row as it "
    "is). A file reads measured while its age, the clock less its written_at, is at most 600 s, "
    "stale (<N> min) past it, else unknown (<reason>). It opens nothing for writing. Exit 0 when "
    "both usage lines read measured, 1 when either does not, 2 for a usage error "
    "(src/README.md).")


def read_file(path, limit=RECORD_LIMIT):
    """The bytes of the file at `path`, or None if it holds more than `limit`. It opens the
    file's directory, then the file relative to it with read_regular, so the file itself may not
    be a symlink, a FIFO or anything but a regular file. A path that ends in a slash names the
    directory itself, which is refused. Raises Refused or OSError."""
    directory, name = os.path.split(path)
    dir_fd = os.open(directory or '.', DIR_FLAGS)
    try:
        return read_regular(name or '.', dir_fd, limit)
    finally:
        os.close(dir_fd)


def unreadable(error):
    """The reason in `unknown (<reason>)` for a file or directory that could not be read."""
    if isinstance(error, Refused):
        return 'refused: %s' % error
    if isinstance(error, FileNotFoundError):
        return 'absent'
    return 'unreadable: %s' % errno.errorcode.get(error.errno, error.errno)


def utc_seconds(value):
    """An integer Unix time as ISO 8601 UTC with a Z, to the second. ValueError unless `value` is
    an int (not a bool) that a UTC time can show, in the years 1 to 9999."""
    if type(value) is not int:
        raise ValueError('not an integer time')
    try:
        moment = datetime.fromtimestamp(value, timezone.utc)
    except (OverflowError, OSError, ValueError):
        raise ValueError('not a time a UTC clock can show') from None
    return '%04d-%02d-%02dT%02d:%02d:%02dZ' % (moment.year, moment.month, moment.day,
                                              moment.hour, moment.minute, moment.second)


def freshness(written_at, now_seconds):
    """(age, state). The age is the clock less written_at, in whole seconds. The state is
    `measured` while the age is at most 600, and past it `stale (<N> min)`, N whole minutes
    rounded down (FINISH.md's F4)."""
    age = now_seconds - written_at
    return age, ('measured' if age <= METERS_FRESH else 'stale (%d min)' % (age // 60))


def parse_usage(raw):
    """FINISH.md step 7's parse of a usage file: (written_at, [five_hour, seven_day], record),
    each window None when it is null, else (used_percentage, resets_at in ISO 8601 UTC).

    It needs an integer written_at, and a rate_limits whose five_hour and seven_day are both
    there, each null or holding a number used_percentage and an integer resets_at. A number is
    one dio who's parse takes for startedAt (finite, not negative, one a float can hold), and an
    integer time one a UTC time can show. Other keys are ignored. Raises ValueError.
    """
    record = strict_json(raw)
    if type(record) is not dict or type(record.get('rate_limits')) is not dict:
        raise ValueError('not a usage file')
    utc_seconds(record.get('written_at'))
    windows = []
    for key in ('five_hour', 'seven_day'):
        if key not in record['rate_limits']:
            raise ValueError('no %s' % key)
        window = record['rate_limits'][key]
        if window is None:
            windows.append(None)
        elif type(window) is dict and _number(window.get('used_percentage')):
            windows.append((window['used_percentage'], utc_seconds(window.get('resets_at'))))
        else:
            raise ValueError('not a window')
    return record['written_at'], windows, record


def compact_json(value):
    """`value` as compact JSON in its own order, or `-` when JSON cannot hold it: a number past a
    float's range, which Python reads as an infinity."""
    try:
        return json.dumps(value, ensure_ascii=False, separators=(',', ':'), allow_nan=False)
    except (ValueError, RecursionError):
        return '-'


def usage_lines(label, path, now_seconds):
    """(the account's `usage` line, its `model_limits` line or None, whether it reads measured).
    The model_limits line is printed where a file in the usage format holds that key."""
    try:
        written_at, windows, record = parse_usage(read_file(path))
    except (Refused, OSError) as e:
        return ['usage', label, 'unknown (%s)' % unreadable(e)] + ['-'] * 5, None, False
    except ValueError:
        return ['usage', label, 'unknown (usage format)'] + ['-'] * 5, None, False
    age, state = freshness(written_at, now_seconds)
    line = ['usage', label, state, str(age)]
    for window in windows:
        line += ['-', '-'] if window is None else [repr(window[0]), window[1]]
    limits = None
    if 'model_limits' in record:
        limits = ['model_limits', label, compact_json(record['model_limits'])]
    return line, limits, state == 'measured'


def session_names(roots):
    """{sessionId: name or None} from every sessions file under `roots` that dio who's reader
    reads and parses. It writes nothing: no process check and no grace cache. When several carry
    one sessionId, the one with the highest pid gives the name (src/README.md, decision 26)."""
    best = {}
    for label, root in roots:
        try:
            outcomes = read_sessions_root(root)
        except OSError as e:
            warn('cannot read the %s sessions directory %s: %s' % (label, root, e.strerror))
            continue
        for _, outcome in outcomes:
            if type(outcome) is dict and outcome['sessionId'] is not None:
                held = best.get(outcome['sessionId'])
                if held is None or outcome['pid'] > held[0]:
                    best[outcome['sessionId']] = (outcome['pid'], outcome['name'])
    return {session_id: name for session_id, (_, name) in best.items()}


def parse_context(raw, session_id):
    """The parse of a context file, <session id>.json: (written_at, used_percentage or None,
    session_name or None).

    It needs an integer written_at, a time as in a usage file; a session_id equal to the id in
    the file's name, as the writer names it; a context_window that is absent, null, or an object
    whose used_percentage is absent, null or a number; and a session_name that is absent, null
    or a string. Other keys are ignored. Raises ValueError.
    """
    record = strict_json(raw)
    if type(record) is not dict or record.get('session_id') != session_id:
        raise ValueError("not this session's context file")
    utc_seconds(record.get('written_at'))
    window = record.get('context_window')
    used = None if type(window) is not dict else window.get('used_percentage')
    if window is not None and (type(window) is not dict or not (used is None or _number(used))):
        raise ValueError('not a context_window')
    name = record.get('session_name')
    if name is not None and type(name) is not str:
        raise ValueError('not a session_name')
    return record['written_at'], used, name or None


def context_lines(roots, names, now_seconds):
    """The `context` lines: one per <id>.json in each root, by account (in the order the roots
    come), then by session id; or one `unknown` line for a root that cannot be read. The names
    of other entries are dropped as os.scandir returns them, unread and unstat'ed."""
    order, keyed = {}, []
    for label, root in roots:
        rank = order.setdefault(label, len(order))
        try:
            dir_fd = os.open(root, DIR_FLAGS)
        except OSError as e:
            keyed.append(((rank, ''), ['context', label] + ['-'] * 4 + ['unknown (%s)' % unreadable(e)]))
            continue
        try:
            found = sorted(entry.name for entry in os.scandir(dir_fd)
                           if CONTEXT_FILE.fullmatch(entry.name))
            for file_name in found:
                session_id = file_name[:-len('.json')]
                own, used, age = None, '-', '-'
                try:
                    written_at, figure, own = parse_context(read_regular(file_name, dir_fd), session_id)
                except FileNotFoundError:
                    continue  # removed since the listing: the writer prunes a file idle a week
                except (Refused, OSError) as e:
                    state = 'unknown (%s)' % unreadable(e)
                except ValueError:
                    state = 'unknown (context format)'
                else:
                    seconds, state = freshness(written_at, now_seconds)
                    age = str(seconds)
                    if figure is not None:
                        used = repr(figure)
                if session_id in names:
                    name = names[session_id] or '-'
                else:
                    name = 'statusline:' + own if own else '-'
                keyed.append(((rank, session_id), ['context', label, session_id, name, used, age, state]))
        except OSError as e:
            keyed.append(((rank, ''), ['context', label] + ['-'] * 4 + ['unknown (%s)' % unreadable(e)]))
        finally:
            os.close(dir_fd)
    return [line for _, line in sorted(keyed, key=lambda pair: pair[0])]


def ledger_cells(line):
    """The cells of a Markdown table line that starts with `|`: the text between its pipes. Every
    `|` separates two cells, and a last `|` closes the line."""
    parts = line.rstrip().split('|')
    return parts[1:-1] if len(parts) > 1 and parts[-1] == '' else parts[1:]


def ledger_header_fault(lines):
    """None when line 1 is the ledger's header and line 2 a separator of 8 cells; else the first
    of the two that is not, as it is, or `-` when it is missing."""
    for number, wanted in ((0, 'header'), (1, 'separator')):
        if len(lines) <= number:
            return '-'
        line = lines[number]
        cells = [cell.strip() for cell in ledger_cells(line)] if line.startswith('|') else []
        if wanted == 'header' and tuple(cells) != LEDGER_HEADER:
            return line
        if wanted == 'separator' and (len(cells) != 8 or not all(
                SEPARATOR_CELL.fullmatch(cell) for cell in cells)):
            return line
    return None


def ledger_lines(label, path):
    """The `credits` lines of one ledger: each row as it is, with its pool, labelled uncorrected.
    A ledger that cannot be read, or whose line 1 is not the header or line 2 not a separator,
    gives one `unknown` line; a row of other than 8 cells gives one in its place."""
    def unknown(reason, line):
        return ['credits', label, '-', 'unknown (%s)' % reason, line]
    try:
        raw = read_file(path, LEDGER_LIMIT)
    except (Refused, OSError) as e:
        return [unknown(unreadable(e), '-')]
    if raw is None:
        return [unknown('ledger format', '-')]
    # A byte that is not UTF-8 is kept as a lone surrogate, which decision 20 prints as \xNN.
    lines = raw.decode('utf-8', 'surrogateescape').split('\n')
    if lines[-1] == '':
        lines.pop()  # the newline that ends the last line
    fault = ledger_header_fault(lines)
    if fault is not None:
        return [unknown('ledger format', fault)]
    found = []
    for line in lines[2:]:
        if not line.startswith('|'):
            continue
        cells = ledger_cells(line)
        if len(cells) != 8:
            found.append(unknown('ledger format', line))
        else:
            pool = 'team-org' if cells[2].strip().endswith(TEAM_JOB) else 'individual-org'
            found.append(['credits', label, pool, 'uncorrected', line])
    return found


def meters(usage_files, context_roots, ledgers, sessions_roots, now):
    """FINISH.md step 7. Returns (exit status, stdout lines, stderr lines). Every field passes
    through decision 20's escapes, so no field adds a tab or a line."""
    now_seconds = math.floor(now().timestamp())
    lines, limits, measured = [], [], 0
    for label, path in usage_files:
        line, limit, fresh = usage_lines(label, path, now_seconds)
        lines.append(line)
        limits += [limit] if limit else []
        measured += fresh
    lines += limits
    lines += context_lines(context_roots, session_names(sessions_roots), now_seconds)
    for label, path in ledgers:
        lines += ledger_lines(label, path)
    status = 0 if measured == len(usage_files) else 1
    return status, ['\t'.join(printable(field) for field in line) for line in lines], []


# ---------------------------------------------------------------- command line

def _seconds(text):
    if not re.fullmatch(r'[0-9]{1,6}', text, re.ASCII) or not 1 <= int(text) <= WATCH_LIMIT:
        raise argparse.ArgumentTypeError('expected whole seconds from 1 to %d, got %r'
                                         % (WATCH_LIMIT, text))
    return int(text)


def _sessions_root(text):
    label, sep, path = text.partition('=')
    if not sep or not label or not path or not _text(label) or ' ' in label:
        raise argparse.ArgumentTypeError('expected LABEL=PATH, got %r' % text)
    return label, path


def _positive(text):
    if not text.isdigit() or int(text) <= 0:
        raise argparse.ArgumentTypeError('expected a positive pid, got %r' % text)
    return int(text)


def build_parser():
    parser = argparse.ArgumentParser(prog='dio', description='Diogenes 0.0-min: presence from '
                                     "Claude Code's sessions files, and the register fallback.")
    commands = parser.add_subparsers(dest='command', required=True)
    who = commands.add_parser('who', help='list sessions, by prefix, or resolve an address')
    form = who.add_mutually_exclusive_group()
    form.add_argument('--prefix', metavar='P',
                      help='live sessions whose name starts with P, sorted by the trailing _N')
    form.add_argument('--address', metavar='X',
                      help='the socket for a role on the role line, an exact live name, '
                           'or a bare prefix (X_N)')
    who.add_argument('--highest', action='store_true',
                     help='with --address, a bare prefix with several live matches resolves '
                          'to the highest _N')
    who.add_argument('--sessions-root', metavar='LABEL=PATH', action='append', type=_sessions_root,
                     help='a sessions directory and its account label; repeatable; replaces '
                          'the defaults max=~/.claude/sessions and team=~/.claude-team/sessions')
    who.add_argument('--state-root', metavar='PATH',
                     help='the directory holding cache/ and roster/ '
                          '(default ~/.local/share/diogenes)')
    who.add_argument('--roles', metavar='PATH',
                     help="the role file (default meta/ROLES.md in dio's own repository)")
    reg = commands.add_parser('register', help="the fallback: write this seat's roster entry "
                              'from $CLAUDE_CODE_MESSAGING_SOCKET')
    reg.add_argument('name', help="the seat's name")
    reg.add_argument('--state-root', metavar='PATH',
                     help='the directory holding roster/ (default ~/.local/share/diogenes)')
    reg.add_argument('--config-dir', metavar='PATH',
                     help='the config dir that keys the entry (default $CLAUDE_CONFIG_DIR, '
                          'else ~/.claude)')
    reg.add_argument('--pid', type=_positive,
                     help="the session's pid, if the socket file is not named <pid>.sock")
    wat = commands.add_parser('watch', help='the background wait: WAKE <path> on a new regular '
                              'file in DIR, or REARM <dir> at the cap', description=WATCH_HELP)
    wat.add_argument('directory', metavar='DIR', help='the directory to watch, such as an inbox')
    wat.add_argument('--every', metavar='S', type=_seconds, default=WATCH_EVERY,
                     help='seconds between polls, 1 to %d (default %d)' % (WATCH_LIMIT, WATCH_EVERY))
    wat.add_argument('--max', metavar='S', type=_seconds, default=WATCH_CAP,
                     help='the cap: after S seconds with no new file, print REARM <dir> and exit 1, '
                          'so the seat re-arms; 1 to %d (default %d, provisional until the gate: '
                          'a background loop is measured to 10 minutes only, and the time past '
                          "10 minutes is untested until the gate's 2-hour leg)"
                          % (WATCH_LIMIT, WATCH_CAP))
    met = commands.add_parser('meters', help="both accounts' usage and context files and the "
                              'credits ledgers, read only', description=METERS_HELP)
    met.add_argument('--max-usage', metavar='PATH',
                     help="the Max account's usage file (default ~/.claude/usage-latest.json)")
    met.add_argument('--team-usage', metavar='PATH',
                     help="the Team account's usage file (default ~/Team/CONFIG/usage-latest.json)")
    met.add_argument('--context-root', metavar='LABEL=PATH', action='append', type=_sessions_root,
                     help='a context directory and its account label; repeatable; replaces the '
                          'defaults max=~/.claude/context and team=~/Team/CONFIG/context')
    met.add_argument('--ledger', metavar='LABEL=PATH', action='append', type=_sessions_root,
                     help='a credits ledger and its source label; repeatable; replaces the defaults '
                          'management=~/Workspace/MANAGEMENT/credits/LEDGER.md and '
                          'libs=~/Workspace/REPOS/nitpick-libs/.internal/credits/LEDGER.md')
    met.add_argument('--sessions-root', metavar='LABEL=PATH', action='append', type=_sessions_root,
                     help="a sessions directory, read for the context lines' names; repeatable; "
                          'replaces the defaults max=~/.claude/sessions and '
                          'team=~/.claude-team/sessions')
    parser.who_parser = who
    return parser


def main(argv=None, now=utc_now, environ=None, clock=None):
    environ = os.environ if environ is None else environ
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.command == 'watch':
        status, out, err = watch(args.directory, args.every, args.max, clock or SystemClock())
    elif args.command == 'meters':
        usage = dict(default_usage_files())
        for label, path in (('max', args.max_usage), ('team', args.team_usage)):
            if path is not None:
                usage[label] = path
        status, out, err = meters([('max', usage['max']), ('team', usage['team'])],
                                  args.context_root or default_context_roots(),
                                  args.ledger or default_ledgers(),
                                  args.sessions_root or default_sessions_roots(), now)
    elif args.command == 'register':
        status, out, err = register(args.name, args.state_root or default_state_root(),
                                    args.config_dir, args.pid, environ, now)
    else:
        state_root = args.state_root or default_state_root()
        if args.highest and args.address is None:
            parser.who_parser.error('--highest needs --address')
        rows = survey(args.sessions_root or default_sessions_roots(), state_root, now)
        if args.address is not None:
            status, out, err = resolve_address(rows, args.address, args.highest,
                                               args.roles or default_role_file())
        elif args.prefix is not None:
            matches = sorted((r for r in rows if r.live and r.name and r.name.startswith(args.prefix)),
                             key=trailing_key)
            if matches:
                status, out, err = 0, [render(matches, boot_clock())], []
            else:
                status, out, err = 1, [], ["dio: no live session's name starts with %s" % args.prefix]
        else:
            status, out, err = 0, [render(rows, boot_clock())], []
    for line in out:
        print(line)
    for line in err:
        print(line, file=sys.stderr)
    return status


if __name__ == '__main__':
    sys.exit(main())
